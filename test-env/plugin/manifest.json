{
  "manifest_version": 3,
  "name": "智能调度中心",
  "version": "3.0.0",
  "description": "关注/养号/私信推广 智能轮换调度",
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "智能调度中心"
  },
  "options_ui": {
    "page": "ui/dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://192.168.0.100:*/*",
    "http://127.0.0.1:*/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.twimg.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "config.js",
        "core/clock.js",
        "core/error-reporter.js",
        "core/link-guard.js",
        "tracking/quota.js",
        "tracking/daily-log.js",
        "engines/engine-base.js",
        "engines/follow.js",
        "engines/nurture.js",
        "engines/chat.js",
        "ui/manual-buttons.js",
        "ui/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
