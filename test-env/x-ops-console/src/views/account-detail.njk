<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <title>{{ account.x_handle }} - 账号详情</title>
    <link rel="stylesheet" href="/public/app.css">
    <style>
      .acct-cfg .cfg-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #21262d}
      .acct-cfg .lbl{min-width:130px;font-size:13px;color:#c9d1d9}
      .acct-cfg input[type=number]{width:80px;background:#0d1117;border:1px solid #30363d;color:#c9d1d9;padding:5px 8px;border-radius:4px}
      .acct-cfg .hint{font-size:11px;color:#8b949e;margin-left:8px}
      .acct-cfg .mod-row{display:flex;gap:16px;margin:10px 0}
      .acct-cfg .mod-row label{font-size:13px;color:#c9d1d9}
      .btn-save{padding:6px 20px;background:#238636;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:13px}
      .btn-delete{padding:6px 20px;background:#da3633;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:13px;margin-left:8px}
      .btn-delete:hover{background:#f85149}
      .save-msg{margin-left:12px;font-size:12px;color:#3fb950}
      .eff-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
      .eff-item{background:#0d1117;border:1px solid #21262d;border-radius:4px;padding:8px;font-size:12px}
      .eff-item .k{color:#8b949e}.eff-item .v{color:#58a6ff;font-weight:600}
    </style>
  </head>
  <body>
    <header class="shell-header">
      <h1>X 运营轻总控后台</h1>
      {% set navActive = 'accounts' %}
      {% include 'partials/shell-nav.njk' %}
    </header>
    <main class="shell-main">
      <section class="panel detail-panel">
        <div class="panel-heading">
          <div style="display:flex;align-items:center;gap:10px">
            <h2>{{ account.display_name or account.x_handle }}</h2>
            {% if account.status == 'frozen' or account.status == 'banned' %}<span class="tag" style="background:#f85149;color:#fff;font-weight:600">账号被封禁</span>
            {% elif account.is_online %}<span class="tag success">在线</span>
            {% else %}<span class="tag warning">离线</span>{% endif %}
          </div>
          <button type="button" id="acctRemoteStartBtn" class="btn-save" style="margin-right:8px" {% if account.status == 'frozen' or account.status == 'banned' %}disabled title="账号已封禁"{% endif %}>远程启动</button>
          <button type="button" id="acctRemotePauseBtn" class="btn-reset" style="margin-right:8px;padding:6px 16px;background:#21262d;color:#c9d1d9;border:1px solid #30363d;border-radius:4px;cursor:pointer;font-size:13px" {% if account.status == 'frozen' or account.status == 'banned' %}disabled title="账号已封禁"{% endif %}>远程暂停</button>
          <button type="button" id="acctDeleteBtn" class="btn-delete">删除账号</button>
        </div>
        {% if account.status == 'frozen' or account.status == 'banned' %}
        <div style="margin:0 0 12px;padding:10px 14px;background:rgba(248,81,73,.12);border:1px solid #f85149;border-radius:6px;color:#ff7b72;font-size:13px">
          该账号已因关注冻结停机（插件上报），状态：账号被封禁
        </div>
        {% endif %}
        <dl class="detail-grid">
          <dt>显示名称</dt>
          <dd>{{ account.display_name or '-' }}</dd>
          <dt>运行天数 Day</dt>
          <dd><strong style="color:#58a6ff">{{ account.day_count or 1 }}</strong>
            <span class="muted" style="margin-left:8px;font-size:12px">≥3 可私信；下方可改</span></dd>
          <dt>最后活跃</dt>
          <dd>{{ account.last_seen_at or '-' }}</dd>
          <dt>备注</dt>
          <dd>{{ account.notes or '-' }}</dd>
        </dl>
      </section>

      <section class="panel section-gap acct-cfg">
        <div class="panel-heading">
          <h2>按账号配置</h2>
          <span class="muted">覆盖全局默认值，插件按 bot_id 拉取后约 1 分钟生效</span>
        </div>
        <form id="acctCfgForm">
          <div class="cfg-row">
            <span class="lbl">运行天数 Day</span>
            <input type="number" name="day_count" min="1" max="9999" value="{{ account.day_count or 1 }}">
            <span class="hint">老号建议 ≥3；保存后插件约 1 分钟同步本地</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">每日关注上限</span>
            <input type="number" name="daily_follow_limit" min="0" max="500" value="{{ account.daily_follow_limit }}">
            <span class="hint">全局默认 {{ globalConfig.thresholds.follow_daily_limit }}</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">每日私信上限</span>
            <input type="number" name="daily_dm_limit" min="0" max="9999" value="{{ account.daily_dm_limit }}">
            <span class="hint">已废除拦截（4.1.41）；字段仅展示，发信不再因此被挡</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">每日转帖上限</span>
            <input type="number" name="daily_repost_limit" min="0" max="100" placeholder="留空=全局" value="{{ account.daily_repost_limit or '' }}">
            <span class="hint">留空=全局配额（Day1-4:{{ effective.thresholds.repost_day14_quota or 2 }}，Day5+:{{ effective.thresholds.repost_day5_quota or 1 }}）；填数字则该号每天发这么多帖</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">上班 / 下班</span>
            <input type="time" name="work_start" value="{{ account.work_start or '' }}" style="background:#0d1117;border:1px solid #30363d;color:#c9d1d9;padding:4px 6px;border-radius:4px">
            <span style="margin:0 4px">~</span>
            <input type="time" name="work_end" value="{{ account.work_end or '' }}" style="background:#0d1117;border:1px solid #30363d;color:#c9d1d9;padding:4px 6px;border-radius:4px">
            <span class="hint">留空=跟随全局工作窗（{{ globalWorkHoursLabel }}）。只填一侧=只覆盖该侧。下班不固定时随时改，约1分钟生效</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">关注间隔 (秒)</span>
            <input type="number" name="follow_interval_min_sec" min="2" max="120" placeholder="留空=全局"
              value="{{ overrides.follow_interval_min_sec or '' }}">
            <span>—</span>
            <input type="number" name="follow_interval_max_sec" min="2" max="120" placeholder="留空=全局"
              value="{{ overrides.follow_interval_max_sec or '' }}">
          </div>
          <div class="cfg-row">
            <span class="lbl">养号日赞/评</span>
            <input type="number" name="nurture_daily_likes" min="0" max="200" placeholder="赞"
              value="{{ overrides.nurture_daily_likes or '' }}">
            <span>/</span>
            <input type="number" name="nurture_daily_comments" min="0" max="100" placeholder="评"
              value="{{ overrides.nurture_daily_comments or '' }}">
            <span class="hint">留空=全局；转帖用系统养号页 1~2 随机</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">号池来源</span>
            <select name="pool_server" style="background:#0d1117;border:1px solid #30363d;color:#c9d1d9;padding:4px 8px;border-radius:4px">
              <option value="">跟随全局{{ poolSourceHint }}</option>
              <option value="http://192.168.0.100:15678" {{ 'selected' if overrides.pool_server == 'http://192.168.0.100:15678' else '' }}>主池 78（15678）</option>
              <option value="http://192.168.0.100:15679" {{ 'selected' if overrides.pool_server == 'http://192.168.0.100:15679' else '' }}>兼职池 79（15679）</option>
            </select>
            <span class="hint">仅影响本号关注领号来源，保存后插件约1分钟生效；选「跟随全局」并保存=清除单号覆盖。79池仅内网可达，插件不会回退到78池外网兜底</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">只关注日文</span>
            <label><input type="checkbox" name="follow_only_japanese"
              {{ 'checked' if (overrides.follow_only_japanese is defined and (overrides.follow_only_japanese == true or overrides.follow_only_japanese == 'true')) or (overrides.follow_only_japanese is not defined and (effective.thresholds.follow_only_japanese != false and effective.thresholds.follow_only_japanese != 'false')) else '' }}>
              开启</label>
            <span class="hint">留勾=用当前生效值；取消勾选后保存会写入 false</span>
          </div>
          <div class="cfg-row">
            <span class="lbl">防封模式</span>
            <label><input type="checkbox" name="follow_antiban_enabled"
              {{ 'checked' if (overrides.follow_antiban_enabled == true or overrides.follow_antiban_enabled == 'true' or (overrides.follow_antiban_enabled is not defined and (effective.thresholds.follow_antiban_enabled == true or effective.thresholds.follow_antiban_enabled == 'true'))) else '' }}>
              开启</label>
          </div>
          {% set tagOff = effective.account.tag_disabled or [] %}
          <div class="cfg-row" style="align-items:flex-start">
            <span class="lbl">管理标签</span>
            <div style="flex:1;max-width:560px">
              {% for tp in tagPresets %}
              <label style="display:inline-flex;align-items:center;gap:4px;margin:0 14px 6px 0;font-size:13px;color:#c9d1d9">
                <input type="checkbox" name="acct_tag" value="{{ tp.id }}" {% if tp.id in account.tagsParsed %}checked{% endif %}> {{ tp.label }}
                <span class="hint">{{ tp.desc }}</span>
              </label>
              {% endfor %}
              <div class="hint" style="display:block;margin:4px 0 0">标签关闭的模块无视下方勾选（关闭优先）；多个标签取「关闭」并集；取消标签后该模块回落全局开关/手动勾选。插件约 1 分钟内生效。</div>
            </div>
          </div>
          <div class="mod-row">
            <label><input type="checkbox" name="module_follow" {{ 'checked' if effective.modules.follow else '' }} {% if 'follow' in tagOff %}disabled title="已由标签关闭"{% endif %}> 关注{% if 'follow' in tagOff %}<span class="hint">标签关</span>{% endif %}</label>
            <label><input type="checkbox" name="module_nurture" {{ 'checked' if effective.modules.nurture else '' }} {% if 'nurture' in tagOff %}disabled title="已由标签关闭"{% endif %}> 养号{% if 'nurture' in tagOff %}<span class="hint">标签关</span>{% endif %}</label>
            <label><input type="checkbox" name="module_chat" {{ 'checked' if effective.modules.chat else '' }} {% if 'chat' in tagOff %}disabled title="已由标签关闭"{% endif %}> 私信{% if 'chat' in tagOff %}<span class="hint">标签关</span>{% endif %}</label>
            <label><input type="checkbox" name="module_repost" {{ 'checked' if effective.modules.repost else '' }} {% if 'repost' in tagOff %}disabled title="已由标签关闭"{% endif %}> 转帖{% if 'repost' in tagOff %}<span class="hint">标签关</span>{% endif %}</label>
          </div>
          <div class="cfg-row" style="align-items:flex-start;flex-wrap:wrap">
            <span class="lbl">转帖来源号</span>
            <div style="flex:1;min-width:220px">
              {% if source_pool and source_pool.length %}
              <div style="display:flex;flex-wrap:wrap;gap:6px 14px;max-width:520px;max-height:180px;overflow-y:auto;border:1px solid #30363d;border-radius:4px;padding:8px;background:#0d1117">
                {% for s in source_pool %}
                <label style="display:flex;align-items:center;gap:4px;font-size:13px;cursor:pointer;{{ 'opacity:.55' if s.status == 'banned' else '' }}" title="{{ s.note or '' }}{{ '（已封禁，勾选也不会下发）' if s.status == 'banned' else '' }}">
                  <input type="checkbox" name="rp_src" value="{{ s.handle }}" {{ 'checked' if s.handle in repost_selected else '' }}>
                  <span style="font-family:ui-monospace,monospace">@{{ s.handle }}</span>
                  {% if s.status == 'banned' %}<span style="color:#f85149;font-size:11px">封</span>{% endif %}
                </label>
                {% endfor %}
              </div>
              <div class="hint" style="margin:6px 0 0">从<a href="/sources" target="_blank" style="color:#1f6feb">来源号池</a>勾选；全部不勾并保存=删除本号绑定（回落全局模板）。已封禁（红标）即使勾选也不会下发。插件约1分钟内生效。</div>
              {% else %}
              <div class="hint" style="color:#e3b341">来源号池为空，请先到<a href="/sources" target="_blank" style="color:#1f6feb">来源号池</a>登记，再回来勾选。</div>
              {% endif %}
            </div>
          </div>
          <div style="margin-top:14px">
            <button type="submit" class="btn-save">保存账号配置</button>
            <span id="saveMsg" class="save-msg"></span>
          </div>
        </form>
        <div class="eff-grid">
          <div class="eff-item"><div class="k">生效关注限额</div><div class="v">{{ effective.thresholds.follow_daily_limit }}</div></div>
          <div class="eff-item"><div class="k">私信节奏</div><div class="v">冷却控频（无每日次数帽）</div></div>
          <div class="eff-item"><div class="k">生效关注间隔</div><div class="v">{{ effective.thresholds.follow_interval_min_sec }}-{{ effective.thresholds.follow_interval_max_sec }}s</div></div>
        </div>
      </section>

      {% if todayStats %}
      <section class="panel section-gap">
        <div class="panel-heading">
          <h2>今日工作统计</h2>
          <span class="muted">{{ todayStats.stat_date }}</span>
        </div>
        <div class="kpi-row" style="grid-template-columns: repeat(3, 1fr);">
          <div class="kpi-card val-yellow">
            <div class="kpi-num">{{ todayStats.follow_count }}</div>
            <div class="kpi-label">关注 ({{ (todayStats.follow_duration_sec / 60) | round(0) }}分)</div>
          </div>
          <div class="kpi-card val-green">
            <div class="kpi-num">{{ todayStats.chat_rounds }}</div>
            <div class="kpi-label">私信轮次</div>
          </div>
          <div class="kpi-card val-blue">
            <div class="kpi-num">{{ todayStats.nurture_likes }}</div>
            <div class="kpi-label">养号赞/{{ todayStats.nurture_comments }}评</div>
          </div>
        </div>
      </section>
      {% endif %}

      {% if dmStats %}
      <section class="panel section-gap">
        <div class="panel-heading">
          <h2>今日私信统计</h2>
          <span class="muted">DM 轮次分布</span>
        </div>
        <div class="kpi-row" style="grid-template-columns: repeat(4, 1fr);">
          <div class="kpi-card val-yellow">
            <div class="kpi-num">{{ dmStats.icebreaker_sent }}</div>
            <div class="kpi-label">破冰</div>
          </div>
          <div class="kpi-card" style="--val-color:#f0883e;">
            <div class="kpi-num" style="color:#f0883e;">{{ dmStats.ad_sent }}</div>
            <div class="kpi-label">广告</div>
          </div>
          <div class="kpi-card val-purple">
            <div class="kpi-num">{{ dmStats.kick_sent }}</div>
            <div class="kpi-label">催加</div>
          </div>
          <div class="kpi-card val-green">
            <div class="kpi-num">{{ dmStats.completed }}</div>
            <div class="kpi-label">已完成</div>
          </div>
        </div>
      </section>
      {% endif %}

      <section class="panel section-gap">
        <div class="panel-heading">
          <h2>运行日志</h2>
          <span class="muted">
            <a href="/runtime-logs?handle={{ account.x_handle }}" style="color:#58a6ff">查看全部 →</a>
          </span>
        </div>
        {% if latestSnapshot %}
        <div style="margin-bottom:10px;padding:8px 12px;background:#0d1117;border:1px solid #21262d;border-radius:6px;font-size:12px">
          最新诊断包：<span class="mono">{{ latestSnapshot.created_at }}</span>
          <a href="/runtime-logs/snapshot/{{ latestSnapshot.id }}" style="color:#58a6ff;margin-left:8px">查看详情</a>
          <a href="/api/telemetry/snapshot/{{ latestSnapshot.id }}" target="_blank" style="color:#58a6ff;margin-left:8px">下载 JSON</a>
          {% if telemetrySnapshots and telemetrySnapshots.length > 1 %}
          <span class="muted" style="margin-left:8px">近 {{ telemetrySnapshots.length }} 次快照</span>
          {% endif %}
        </div>
        {% else %}
        <p class="muted" style="font-size:12px;margin-bottom:8px">暂无诊断包。请在插件面板点「上报诊断」。</p>
        {% endif %}
        <table class="data-table compact">
          <thead><tr><th>时间</th><th>级别</th><th>事件</th><th>说明</th></tr></thead>
          <tbody>
            {% for log in telemetryLogs %}
            <tr>
              <td class="mono">{{ log.created_at.slice(5, 19) }}</td>
              <td><span class="tag {{ 'warning' if log.severity == 'warn' else ('danger' if log.severity == 'error' else '') }}">{{ log.severity }}</span></td>
              <td>{{ log.label_zh or log.event_id }}</td>
              <td class="mono" style="font-size:11px;color:#8b949e">{{ log.meta.reason or log.meta.target or log.meta.phase or '-' }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="empty-cell">暂无运行日志（插件上报后可见）</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="panel section-gap">
        <div class="panel-heading">
          <h2>最近操作</h2>
          <span class="muted">最新 30 条</span>
        </div>
        <table class="data-table compact">
          <thead><tr><th>时间</th><th>操作</th><th>目标</th></tr></thead>
          <tbody>
            {% set actionLabels = {'follow':'关注','follow_back':'回关','ice_sent':'破冰','ad_sent':'广告','kick_sent':'盾牌','reject_sent':'婉拒','skip':'跳过','dm':'私信'} %}
            {% for log in account.recentActivities %}
            <tr>
              <td class="mono">{{ log.created_at.slice(5, 16) }}</td>
              <td><span class="tag">{{ actionLabels[log.action_type] or log.action_type }}</span></td>
              <td>{{ log.target_handle or '-' }}</td>
            </tr>
            {% else %}
            <tr><td colspan="3" class="empty-cell">暂无操作记录</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    </main>
    <script>
    (function () {
      var form = document.getElementById('acctCfgForm');
      var msg = document.getElementById('saveMsg');
      var handle = {{ account.x_handle | dump | safe }};
      var accountId = {{ account.id }};

      function numOrNull(v) {
        if (v === '' || v == null) return null;
        var n = Number(v);
        return isNaN(n) ? null : n;
      }

      var delBtn = document.getElementById('acctDeleteBtn');
      function sendRemoteCommand(cmd, btn, doneText) {
        if (!btn) return;
        btn.disabled = true;
        var old = btn.textContent;
        btn.textContent = '下发中…';
        fetch('/api/accounts/' + encodeURIComponent(accountId) + '/command', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command: cmd })
        }).then(function (r) { return r.json(); }).then(function (res) {
          if (res.ok) {
            btn.textContent = doneText;
            setTimeout(function () { btn.textContent = old; btn.disabled = false; }, 2000);
          } else {
            alert(res.msg || '下发失败');
            btn.textContent = old;
            btn.disabled = false;
          }
        }).catch(function () {
          alert('网络错误');
          btn.textContent = old;
          btn.disabled = false;
        });
      }
      var startBtn = document.getElementById('acctRemoteStartBtn');
      var pauseBtn = document.getElementById('acctRemotePauseBtn');
      if (startBtn) startBtn.addEventListener('click', function () {
        sendRemoteCommand('start', startBtn, '已下发，插件约10秒内执行');
      });
      if (pauseBtn) pauseBtn.addEventListener('click', function () {
        sendRemoteCommand('pause', pauseBtn, '已下发暂停');
      });
      if (delBtn) {
        delBtn.addEventListener('click', function () {
          delBtn.disabled = true;
          delBtn.textContent = '删除中…';
          fetch('/api/accounts/' + encodeURIComponent(accountId), { method: 'DELETE' })
            .then(function (r) { return r.json(); })
            .then(function (res) {
              if (res.ok) {
                location.href = '/accounts';
              } else {
                alert(res.msg || '删除失败');
                delBtn.disabled = false;
                delBtn.textContent = '删除账号';
              }
            })
            .catch(function () {
              alert('网络错误');
              delBtn.disabled = false;
              delBtn.textContent = '删除账号';
            });
        });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        msg.textContent = '保存中…';
        msg.style.color = '#8b949e';

        var fd = new FormData(form);
        var overrides = {};
        ['follow_interval_min_sec','follow_interval_max_sec','nurture_daily_likes','nurture_daily_comments'].forEach(function (k) {
          var val = numOrNull(fd.get(k));
          overrides[k] = val;
        });
        overrides.follow_only_japanese = form.querySelector('[name=follow_only_japanese]').checked ? 'true' : 'false';
        overrides.follow_antiban_enabled = form.querySelector('[name=follow_antiban_enabled]').checked ? 'true' : 'false';
        // 号池来源：空=删除 override 回落全局；有值=完整 URL 下发（H1 通用 override 通道）
        overrides.pool_server = (fd.get('pool_server') || '') || null;

        // H9：从来源号池勾选收集（已按池登记天然去重）
        var rpLines = Array.prototype.map.call(
          form.querySelectorAll('[name=rp_src]:checked'),
          function (el) { return String(el.value || '').replace(/^@/, '').toLowerCase().trim(); }
        ).filter(Boolean);
        // 空勾选 → 删除 override（回落全局）；有勾选 → JSON 数组
        overrides.repost_targets = rpLines.length ? JSON.stringify(rpLines) : null;

        var tagOff = {{ tagDisabledJson | safe }};
        var tags = Array.prototype.map.call(
          form.querySelectorAll('[name=acct_tag]:checked'),
          function (el) { return el.value; }
        );
        // 标签关闭的模块 → 下发 null 删除 override，状态跟随标签；移除标签后回落全局/手动
        var modules = {};
        ['follow', 'nurture', 'chat', 'repost'].forEach(function (m) {
          if (tagOff.indexOf(m) >= 0) { modules[m] = null; return; }
          modules[m] = !!form.querySelector('[name=module_' + m + ']').checked;
        });

        fetch('/api/config/account/' + encodeURIComponent(handle), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            day_count: numOrNull(fd.get('day_count')),
            daily_follow_limit: numOrNull(fd.get('daily_follow_limit')),
            daily_dm_limit: numOrNull(fd.get('daily_dm_limit')),
            daily_repost_limit: numOrNull(fd.get('daily_repost_limit')),
            work_start: (fd.get('work_start') || '') || null,
            work_end: (fd.get('work_end') || '') || null,
            overrides: overrides,
            modules: modules,
            tags: tags
          })
        }).then(function (r) { return r.json(); }).then(function (res) {
          if (res.ok) {
            msg.textContent = '已保存，插件约 1 分钟内生效';
            msg.style.color = '#3fb950';
            setTimeout(function () { location.reload(); }, 800);
          } else {
            msg.textContent = res.msg || '保存失败';
            msg.style.color = '#f85149';
          }
        }).catch(function () {
          msg.textContent = '网络错误';
          msg.style.color = '#f85149';
        });
      });
    })();
    </script>
  </body>
</html>