<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <title>{{ lead.target_handle }} - 目标详情</title>
    <link rel="stylesheet" href="/public/app.css">
  </head>
  <body>
    <header class="shell-header">
      <h1>X 运营轻总控后台</h1>
      {% set navActive = 'leads' %}
      {% include 'partials/shell-nav.njk' %}
    </header>
    <main class="shell-main">
      <section class="panel detail-panel">
        <div class="panel-heading">
          <h2>{{ lead.target_handle }}</h2>
          {% set stageLabels = {'discovered':'待关注','followed':'已关注','followed_back':'已回关','dm_ready':'待私信','ice_sent':'破冰中','ad_sent':'广告中','kick_sent':'已盾牌','rejected':'已婉拒','dm_sent':'已私信','completed':'已完成','skipped':'已跳过'} %}
          {% set stageColors = {'discovered':'#8b949e','followed':'#58a6ff','followed_back':'#3fb950','dm_ready':'#d29922','ice_sent':'#d29922','ad_sent':'#f0883e','kick_sent':'#a371f7','rejected':'#f85149','dm_sent':'#58a6ff','completed':'#3fb950','skipped':'#8b949e'} %}
          <span class="tag" style="background:{{ stageColors[lead.current_stage] or '#8b949e' }}22;color:{{ stageColors[lead.current_stage] or '#8b949e' }};font-size:13px;">{{ stageLabels[lead.current_stage] or lead.current_stage }}</span>
        </div>
        <dl class="detail-grid">
          <dt>来源</dt>
          <dd>{{ lead.source or '-' }}</dd>
          <dt>处理账号</dt>
          <dd>{{ lead.bound_handle or '未绑定' }}</dd>
          <dt>发现时间</dt>
          <dd>{{ lead.discovered_at or '-' }}</dd>
          <dt>关注时间</dt>
          <dd>{{ lead.followed_at or '-' }}</dd>
          <dt>回关时间</dt>
          <dd>{{ lead.followed_back_at or '-' }}</dd>
          <dt>最后活动</dt>
          <dd>{{ lead.last_activity_at or '-' }}</dd>
          <dt>最后私信动作</dt>
          <dd>{{ lead.last_dm_action or '-' }}</dd>
          <dt>消息快照数</dt>
          <dd>{{ lead.snapshot_count or '0' }}</dd>
          <dt>收口原因</dt>
          <dd>{{ lead.close_reason or '-' }}</dd>
        </dl>
        <div class="action-row">
          <form method="post" action="/leads/{{ lead.id }}/complete">
            <button type="submit">标记完成</button>
          </form>
          <form method="post" action="/leads/{{ lead.id }}/skip">
            <button type="submit" class="secondary-button">标记跳过</button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>